# Vercel uploads every file in the folder unless it is listed here; .gitignore
# does not count. A `vercel` run from a laptop would otherwise ship data/ and
# app/public/data.js. So: ignore everything, then allow only what the build reads.
/*
!/app
!/scripts
!/vercel.json
/scripts/*
!/scripts/leakcheck.sh
/app/public/data.js
/app/public/ledger-edits.json
/app/node_modules
/app/dist
